---
import { siteConfig } from '../data/siteConfig';

const testWaLink = `https://wa.me/${siteConfig.whatsapp.number}?text=${encodeURIComponent(siteConfig.whatsapp.defaultMsg)}`;
---

<header class="sticky top-0 z-50 w-full bg-[#070114]/90 backdrop-blur-md border-b border-purple-900/40 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo (SKY+ Neon Magenta/Violet Inspired) -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#ff007a] via-[#7928ca] to-[#00f0ff] p-[2px] shadow-magenta-glow group-hover:scale-105 transition-transform duration-300">
          <div class="w-full h-full bg-[#070114] rounded-[10px] flex items-center justify-center">
            <svg class="w-5 h-5 text-[#ff007a] group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M4 6.47L5.76 10H20v8H4V6.47M22 4h-4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4z"/>
            </svg>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-xl sm:text-2xl font-black tracking-tight text-white font-display uppercase leading-none">
            CINEMA<span class="text-[#ff007a]">EM</span>CASA
          </span>
          <span class="text-[10px] font-bold text-slate-400 tracking-widest uppercase mt-0.5">
            TV & STREAMING 4K
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-8">
        <a href="/" class="text-sm font-bold text-white hover:text-[#ff007a] transition">
          Início
        </a>
        <a href="/planos" class="text-sm font-bold text-slate-300 hover:text-[#ff007a] transition">
          Planos & Telas
        </a>
        <a href="/canais" class="text-sm font-bold text-slate-300 hover:text-[#ff007a] transition">
          Canais Ao Vivo
        </a>
        <a href="/filmes-e-series" class="text-sm font-bold text-slate-300 hover:text-[#ff007a] transition">
          Filmes & Séries
        </a>
        <a href="/esportes" class="text-sm font-bold text-slate-300 hover:text-[#ff007a] transition">
          Futebol & UFC
        </a>
        <a href="/como-funciona" class="text-sm font-bold text-slate-300 hover:text-[#ff007a] transition">
          Como Funciona
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center gap-4">
        <a
          href={testWaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold text-slate-200 bg-white/5 hover:bg-white/10 border border-purple-500/30 transition hover:border-[#ff007a]"
        >
          <span class="w-2 h-2 rounded-full bg-[#00f0ff] animate-ping"></span>
          <span>Teste 6h Grátis</span>
        </a>

        <a
          href="/planos"
          class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-xs font-black uppercase tracking-wider text-white bg-gradient-to-r from-[#ff007a] to-[#7928ca] hover:opacity-95 shadow-magenta-glow transition hover:scale-105 active:scale-95"
        >
          ASSINAR AGORA
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center lg:hidden gap-3">
        <a
          href={testWaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded-full text-[11px] font-bold text-white bg-[#ff007a]"
        >
          Teste 6h
        </a>
        <button
          id="mobile-menu-btn"
          aria-label="Menu"
          class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-purple-900/50 bg-[#070114]/95 px-4 pt-4 pb-6 space-y-3">
    <a href="/" class="block px-3 py-2 rounded-lg text-base font-bold text-white hover:bg-white/5">
      Início
    </a>
    <a href="/planos" class="block px-3 py-2 rounded-lg text-base font-bold text-slate-300 hover:bg-white/5">
      Planos & Telas (1, 2 e 3 Telas)
    </a>
    <a href="/canais" class="block px-3 py-2 rounded-lg text-base font-bold text-slate-300 hover:bg-white/5">
      Canais Ao Vivo
    </a>
    <a href="/filmes-e-series" class="block px-3 py-2 rounded-lg text-base font-bold text-slate-300 hover:bg-white/5">
      Filmes & Séries
    </a>
    <a href="/esportes" class="block px-3 py-2 rounded-lg text-base font-bold text-slate-300 hover:bg-white/5">
      Futebol & UFC
    </a>
    <a href="/como-funciona" class="block px-3 py-2 rounded-lg text-base font-bold text-slate-300 hover:bg-white/5">
      Como Funciona
    </a>
    <div class="pt-2">
      <a
        href="/planos"
        class="block w-full py-3 text-center rounded-xl font-black text-sm uppercase tracking-wider text-white bg-gradient-to-r from-[#ff007a] to-[#7928ca] shadow-magenta-glow"
      >
        VER NOSSOS PLANOS
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
