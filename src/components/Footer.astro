---
import { siteConfig } from '../data/siteConfig';

const waLink = `https://wa.me/${siteConfig.whatsapp.number}?text=${encodeURIComponent(siteConfig.whatsapp.defaultMsg)}`;
---

<footer class="bg-[#05010e] border-t border-purple-900/40 text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Brand & Mission -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-[#ff007a] via-[#7928ca] to-[#00f0ff] p-[2px]">
            <div class="w-full h-full bg-[#070114] rounded-[10px] flex items-center justify-center">
              <svg class="w-4 h-4 text-[#ff007a]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M4 6.47L5.76 10H20v8H4V6.47M22 4h-4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4z"/>
              </svg>
            </div>
          </div>
          <span class="text-xl font-black text-white uppercase tracking-tight font-display">
            CINEMA<span class="text-[#ff007a]">EM</span>CASA
          </span>
        </a>

        <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
          A melhor plataforma de TV e streaming do Brasil. Assista a mais de 2.500 canais ao vivo, filmes, séries e esportes em até 3 telas simultâneas sem travar e sem fidelidade.
        </p>

        <div class="pt-2 flex items-center gap-3 text-xs font-semibold text-slate-300">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Servidor Online 99.9%
          </span>
          <span class="text-slate-400 font-mono">CDN BRASIL (GRU / GIG)</span>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-xs font-black text-white uppercase tracking-wider mb-4">Plataforma</h4>
        <ul class="space-y-2.5">
          <li><a href="/" class="hover:text-white transition">Início</a></li>
          <li><a href="/planos" class="hover:text-white transition">Planos 1, 2 e 3 Telas</a></li>
          <li><a href="/canais" class="hover:text-white transition">Grade de Canais</a></li>
          <li><a href="/filmes-e-series" class="hover:text-white transition">Catálogo de Filmes</a></li>
          <li><a href="/esportes" class="hover:text-white transition">Futebol & UFC ao Vivo</a></li>
          <li><a href="/como-funciona" class="hover:text-white transition">Aparelhos Compatíveis</a></li>
        </ul>
      </div>

      <!-- Quick Plans -->
      <div>
        <h4 class="text-xs font-black text-white uppercase tracking-wider mb-4">Nossos Planos</h4>
        <ul class="space-y-2.5">
          <li><a href="/planos" class="hover:text-[#00f0ff] transition">Plano Básico (1 Tela) - R$ 29,90</a></li>
          <li><a href="/planos" class="hover:text-[#ff007a] transition font-bold">Plano Padrão (2 Telas) - R$ 39,90</a></li>
          <li><a href="/planos" class="hover:text-purple-400 transition">Plano Família VIP (3 Telas) - R$ 49,90</a></li>
          <li><a href="/planos" class="hover:text-[#ffcc00] transition">Plano Anual Ultra (3 Telas) - R$ 197</a></li>
          <li><a href="/teste-gratis" class="hover:text-emerald-400 transition font-bold">Solicitar Teste 6 Horas</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h4 class="text-xs font-black text-white uppercase tracking-wider mb-4">Atendimento VIP</h4>
        <p class="text-xs text-slate-400 mb-3">
          Suporte humanizado todos os dias das 08h às 23h59 via WhatsApp.
        </p>
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition shadow-lg"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          <span>{siteConfig.whatsapp.display}</span>
        </a>
      </div>

    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="mt-12 pt-8 border-t border-purple-900/30 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        © {new Date().getFullYear()} Cinema em Casa ({siteConfig.domain}). Todos os direitos reservados.
      </p>
      <div class="flex items-center gap-6">
        <a href="/termos" class="hover:text-slate-300 transition">Termos de Uso</a>
        <a href="/privacidade" class="hover:text-slate-300 transition">Política de Privacidade</a>
        <a href="/sitemap.xml" class="hover:text-slate-300 transition">Mapa do Site</a>
      </div>
    </div>
  </div>
</footer>

