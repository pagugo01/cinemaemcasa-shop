---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout title={`Página Não Encontrada - ${siteConfig.name}`}>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-20 bg-[#070114]">
    <span class="text-8xl sm:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[#ff007a] via-[#7928ca] to-[#00f0ff] font-display">
      404
    </span>
    <h1 class="text-2xl sm:text-3xl font-black text-white uppercase mt-4 mb-2">
      Página Não Encontrada
    </h1>
    <p class="text-slate-400 text-sm max-w-md mb-8">
      O conteúdo que você procurava não existe ou foi movido. Retorne para a página inicial para navegar pelo catálogo e pelos planos.
    </p>
    <a
      href="/"
      class="inline-flex items-center px-8 py-3.5 rounded-full text-xs font-black uppercase tracking-wider text-white bg-gradient-to-r from-[#ff007a] to-[#7928ca] shadow-magenta-glow transition hover:scale-105"
    >
      VOLTAR PARA O INÍCIO
    </a>
  </div>
</Layout>

