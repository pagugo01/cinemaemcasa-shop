---
import Layout from '../layouts/Layout.astro';
import BannerPremium from '../components/BannerPremium.astro';
import { siteConfig } from '../data/siteConfig';

const defaultWaMsg = encodeURIComponent(siteConfig.whatsapp.defaultMsg);
const testWaLink = `https://wa.me/${siteConfig.whatsapp.number}?text=${defaultWaMsg}`;

const liveChannels = [
  { name: 'SporTV 4K', cat: 'Esportes', color: 'from-blue-600 to-cyan-500' },
  { name: 'Premiere Clubes', cat: 'Futebol PPV', color: 'from-emerald-600 to-green-500' },
  { name: 'ESPN 1 ao 6', cat: 'Internacional', color: 'from-red-600 to-rose-500' },
  { name: 'Canal Combate', cat: 'UFC Ao Vivo', color: 'from-amber-600 to-orange-500' },
  { name: 'Telecine Premium', cat: 'Filmes 4K', color: 'from-rose-700 to-red-600' },
  { name: 'HBO & Max', cat: 'Séries Originais', color: 'from-purple-700 to-indigo-600' },
  { name: 'TV Globo 4K', cat: 'Todas as Afiliadas', color: 'from-blue-500 to-sky-400' },
  { name: 'Discovery Kids', cat: 'Infantil', color: 'from-teal-500 to-emerald-400' },
  { name: 'GloboNews', cat: 'Notícias 24h', color: 'from-red-700 to-red-500' },
  { name: 'CazéTV', cat: 'Ao Vivo 60FPS', color: 'from-yellow-500 to-amber-600' }
];
---

<Layout>
  
  <!-- ARTICLE 1: BannerHeroCarousel (Carrossel Hero estilo SKY+) -->
  <section class="relative min-h-[85vh] lg:min-h-[92vh] flex items-center bg-[#070114] overflow-hidden">
    
    <!-- Slides Container -->
    <div id="hero-slider" class="relative w-full h-full min-h-[85vh] lg:min-h-[92vh] flex items-center">
      
      <!-- Slide 1: Institucional / Clássicos -->
      <div class="hero-slide absolute inset-0 opacity-100 transition-opacity duration-700 z-10 flex items-center">
        <!-- Background Image -->
        <div class="absolute inset-0 z-0">
          <img
            src="/images/hero_institucional.png"
            alt="Maratone seus clássicos"
            class="w-full h-full object-cover object-right-top filter brightness-90"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-[#070114] via-[#070114]/90 to-transparent w-full lg:w-3/5"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#070114] via-transparent to-transparent"></div>
        </div>

        <!-- Text Content -->
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-16">
          <div class="max-w-xl text-left">
            <span class="inline-block text-xs font-black uppercase tracking-widest text-[#00f0ff] font-mono mb-3">
              ASSINE AGORA
            </span>
            <h1 class="text-4xl sm:text-6xl font-black text-white uppercase tracking-tight font-display leading-[1.05] mb-4">
              MARATONE SEUS CLÁSSICOS.
            </h1>
            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed">
              Cinema em Casa é seu aplicativo para ter o melhor da TV e dos streamings em um só lugar. Planos de 1, 2 e 3 telas sem cabos ou antenas.
            </p>
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
              <a
                href="#planos"
                class="inline-flex items-center justify-center px-8 py-4 rounded-full text-xs font-black uppercase tracking-wider text-white bg-gradient-to-r from-[#ff007a] to-[#7928ca] shadow-magenta-glow hover:scale-105 transition"
              >
                Assinar
              </a>
              <a
                href={testWaLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-7 py-4 rounded-full text-xs font-bold text-white bg-white/10 hover:bg-white/20 border border-white/20 transition"
              >
                Experimentar 6h Grátis
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 2: Futebol e Esportes -->
      <div class="hero-slide absolute inset-0 opacity-0 transition-opacity duration-700 z-0 flex items-center pointer-events-none">
        <div class="absolute inset-0 z-0">
          <img
            src="/images/hero_futebol.png"
            alt="Futebol é no Cinema em Casa"
            class="w-full h-full object-cover object-right-top filter brightness-90"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-[#070114] via-[#070114]/90 to-transparent w-full lg:w-3/5"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#070114] via-transparent to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-16">
          <div class="max-w-xl text-left">
            <span class="inline-block text-xs font-black uppercase tracking-widest text-[#ff007a] font-mono mb-3">
              FUTEBOL AO VIVO EM 4K
            </span>
            <h2 class="text-4xl sm:text-6xl font-black text-white uppercase tracking-tight font-display leading-[1.05] mb-4">
              FUTEBOL É NO CINEMA EM CASA.
            </h2>
            <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed">
              Acompanhe os maiores campeonatos de futebol do Brasil e do mundo (Brasileirão, Libertadores, Champions) além do UFC card completo sem delay.
            </p>
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pointer-events-auto">
              <a
                href="#planos"
                class="inline-flex items-center justify-center px-8 py-4 rounded-full text-xs font-black uppercase tracking-wider text-white bg-gradient-to-r from-[#ff007a] to-[#7928ca] shadow-magenta-glow hover:scale-105 transition"
              >
                Assinar
              </a>
              <a
                href="#esportes"
                class="inline-flex items-center justify-center px-7 py-4 rounded-full text-xs font-bold text-white bg-white/10 hover:bg-white/20 border border-white/20 transition"
              >
                Ver Jogos Inclusos
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Slide Indicators -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
      <button class="slide-indicator w-8 h-2 rounded-full bg-[#ff007a] transition-all" data-slide="0" aria-label="Slide 1"></button>
      <button class="slide-indicator w-2.5 h-2 rounded-full bg-white/30 transition-all hover:bg-white/60" data-slide="1" aria-label="Slide 2"></button>
    </div>
  </section>

  <!-- ARTICLE 3: CardProductSubscriptionCarousel (Escolha o plano ideal pra você) -->
  <section id="planos" class="py-20 bg-[#070114] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <!-- Callout Banner: Tudo em um único aplicativo -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-[#ff007a]/20 via-[#7928ca]/20 to-[#00f0ff]/20 border border-[#00f0ff]/40 text-[#00f0ff] text-xs font-black tracking-widest uppercase mb-4 shadow-cyan-glow">
          <span class="w-2 h-2 rounded-full bg-[#00f0ff] animate-pulse"></span>
          <span>TODO O CONTEÚDO EM UM ÚNICO APLICATIVO</span>
        </div>

        <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight font-display mb-3">
          ASSINATURAS FLEXÍVEIS & SEM MULTA
        </h2>
        <p class="text-sm sm:text-base text-slate-300">
          Escolha a quantidade de telas simultâneas que melhor atende a sua casa. O cliente vê tudo em um só aplicativo com ativação imediata em 2 minutos no WhatsApp.
        </p>
      </div>

      <!-- 4 Official Plans Grid (Identical to User Reference Screenshot) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {siteConfig.plans.map((plan) => {
          const planWaLink = `https://wa.me/${siteConfig.whatsapp.number}?text=${encodeURIComponent(siteConfig.whatsapp.planMsg(plan.name))}`;
          return (
            <div
              class={`relative rounded-3xl flex flex-col justify-between p-6 sm:p-7 transition-all duration-300 ${
                plan.popular
                  ? 'bg-gradient-to-b from-[#1c0840] via-[#14062f] to-[#0d0221] border-2 border-[#00f0ff] shadow-card-glow lg:-translate-y-2'
                  : 'bg-[#100326] border border-purple-900/50 hover:border-purple-500/50'
              }`}
            >
              {plan.badge && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                  <span class={`px-4 py-1 rounded-full text-[10px] font-black uppercase tracking-wider shadow-md ${plan.badgeColor || 'bg-blue-600 text-white'}`}>
                    {plan.badge}
                  </span>
                </div>
              )}

              <div>
                <div class="text-center pt-2 pb-6 border-b border-purple-900/40">
                  <h3 class="text-base font-black text-white uppercase tracking-tight">
                    {plan.name}
                  </h3>
                  
                  <span class="inline-block mt-1 text-xs font-bold text-[#00f0ff]">
                    {plan.screens}
                  </span>

                  <!-- Old price if present -->
                  {plan.oldPrice && (
                    <div class="mt-2 text-xs text-slate-400 line-through">
                      {plan.oldPrice}
                    </div>
                  )}

                  <div class="mt-2 flex items-baseline justify-center gap-1">
                    <span class="text-xs font-bold text-slate-400">R$</span>
                    <span class="text-4xl sm:text-5xl font-black text-white font-display tracking-tight">
                      {plan.price}
                    </span>
                    <span class="text-xs text-slate-400 font-semibold">{plan.period}</span>
                  </div>

                  <p class="text-xs text-slate-400 mt-3 leading-snug">
                    {plan.subtitle}
                  </p>
                </div>

                <ul class="py-6 space-y-3 text-xs text-slate-300">
                  {plan.features.map((feat) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="w-4 h-4 text-[#00f0ff] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span class="leading-tight">{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-4 border-t border-purple-900/40">
                <a
                  href={planWaLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`block w-full py-3.5 px-4 rounded-xl text-center text-xs font-black uppercase tracking-wider transition-all duration-200 ${
                    plan.popular
                      ? 'bg-gradient-to-r from-[#00f0ff] to-[#0099ff] text-black hover:opacity-95 shadow-lg shadow-cyan-500/30'
                      : 'bg-white/10 hover:bg-white/15 text-white border border-purple-500/30'
                  }`}
                >
                  {plan.ctaText}
                </a>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ARTICLE 6: BannerStreamingInfoPoster (Mais de 100 canais ao vivo) -->
  <section id="ao-vivo" class="py-20 bg-[#0c0320] border-y border-purple-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight font-display mb-3">
          MAIS DE 100 CANAIS AO VIVO
        </h2>
        <p class="text-sm sm:text-base text-slate-300">
          Curta filmes, séries, documentários, esportes e acompanhe as últimas notícias em tempo real. Mais de 2.500 opções liberadas no Cinema em Casa.
        </p>
      </div>

      <!-- Live Channels Showcase Row -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {liveChannels.map((ch) => (
          <div class="p-5 rounded-2xl bg-[#14062f] border border-purple-900/40 hover:border-[#00f0ff] transition group hover:-translate-y-1">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">
              {ch.cat}
            </span>
            <h3 class="text-base font-black text-white uppercase group-hover:text-[#00f0ff] transition">
              {ch.name}
            </h3>
            <div class="mt-3 flex items-center gap-1.5 text-[10px] text-emerald-400 font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Sinal Ao Vivo 4K
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center sm:text-left">
        <a
          href="/canais"
          class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-[#00f0ff] hover:underline"
        >
          <span>VER GRADE COMPLETA COM MAIS DE 2.500 CANAIS</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ARTICLE 8: BannerStreamingInfoContent (Tudo o que você gosta, em um só lugar) -->
  <section id="catalogo" class="py-20 bg-[#070114]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-r from-[#14062f] via-[#1f0947] to-[#14062f] border border-purple-500/40 p-8 sm:p-12 overflow-hidden shadow-card-glow">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white uppercase font-display tracking-tight leading-tight mb-4">
              TUDO O QUE VOCÊ GOSTA, EM UM SÓ LUGAR
            </h2>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
              Monte seu plano Cinema em Casa com Disney+ Premium, HBO Max, Prime Video, Paramount+ e muitos outros conteúdos sem pagar faturas extras separadas.
            </p>
            <a
              href="#planos"
              class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-xs font-black uppercase tracking-wider text-white bg-gradient-to-r from-[#ff007a] to-[#7928ca] shadow-magenta-glow hover:scale-105 transition"
            >
              <span>Personalizar meu plano Cinema em Casa</span>
            </a>
          </div>

          <div class="rounded-2xl overflow-hidden border border-purple-500/40 shadow-2xl">
            <img src="/images/banner_vod.png" alt="Catálogo VOD Cinema em Casa" class="w-full h-auto object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARTICLE 10: BannerPremium (VOCÊ TEM TUDO NO CINEMA EM CASA - EXATO COMO NO PRINT) -->
  <BannerPremium />

  <!-- ARTICLE 13: BannerStreamingInfoContent (Só pra quem é fã de futebol) -->
  <section id="esportes" class="py-20 bg-[#0c0320] border-t border-purple-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight font-display mb-3">
          SÓ PRA QUEM É FÃ DE FUTEBOL
        </h2>
        <p class="text-sm sm:text-base text-slate-300">
          Não perca nenhum lance da Champions, do Brasileirão, da Libertadores e muito mais. Transmissões 60 FPS com áudio original.
        </p>
      </div>

      <div class="max-w-4xl mx-auto rounded-3xl overflow-hidden border border-purple-500/40 shadow-card-glow mb-8">
        <img src="/images/banner_canais.png" alt="Futebol ao Vivo" class="w-full h-auto object-cover" />
      </div>

      <div class="text-center">
        <a
          href={testWaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-xs font-black uppercase tracking-wider text-white bg-gradient-to-r from-[#ff007a] to-[#7928ca] shadow-magenta-glow hover:scale-105 transition"
        >
          <span>Assistir as partidas ao vivo</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ARTICLE 15: BannerHighlightHard (Plano Streaming) -->
  <section id="banner" class="py-20 bg-[#070114]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-[#14062f] p-8 sm:p-12 border border-purple-500/40 shadow-card-glow">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div>
            <span class="text-xs font-mono font-black text-[#00f0ff] uppercase tracking-widest">
              SUPER COMBO LIBERADO
            </span>
            <h2 class="text-3xl sm:text-5xl font-black text-white uppercase font-display tracking-tight mt-2 mb-4">
              PLANO STREAMING
            </h2>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
              Amazon Prime, HBO Max, Disney+ Premium, Paramount+ e NFL: toda a diversão que você ama em um único plano com ativação instantânea em 2 minutos.
            </p>
            <a
              href="#planos"
              class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-xs font-black uppercase tracking-wider text-white bg-gradient-to-r from-[#ff007a] to-[#7928ca] shadow-magenta-glow hover:scale-105 transition"
            >
              Assinar Agora
            </a>
          </div>

          <div class="rounded-2xl overflow-hidden border border-purple-500/40">
            <img src="/images/banner_streaming_combo.png" alt="Plano Streaming Combos" class="w-full h-auto object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARTICLE 17: BannerSectionDevices (Assista como e onde quiser) -->
  <section class="py-20 bg-[#0c0320] border-t border-purple-900/40 text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight font-display mb-3">
        ASSISTA COMO E ONDE QUISER
      </h2>
      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto mb-10">
        Baixe o aplicativo Cinema em Casa no seu celular, smart TV ou dispositivo de streaming.
      </p>

      <!-- Mockup Banner -->
      <div class="max-w-3xl mx-auto mb-12">
        <img src="/images/banner_devices.png" alt="Dispositivos Conectados" class="w-full h-auto object-contain" />
      </div>

      <!-- Device Logos Row -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {siteConfig.devices.map((dev) => (
          <div class="p-5 rounded-2xl bg-[#14062f] border border-purple-900/40 flex flex-col items-center justify-center">
            <div class="w-12 h-12 mb-2 p-2 rounded-xl bg-white/5 flex items-center justify-center">
              <img src={dev.img} alt={dev.name} class="max-h-full max-w-full object-contain filter brightness-110" />
            </div>
            <span class="text-xs font-bold text-white mt-1">{dev.name}</span>
            <span class="text-[10px] text-slate-400">{dev.sub}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ARTICLE 19: FaqQuickAccordion (Outras informações - FAQ) -->
  <section id="ajuda" class="py-20 bg-[#070114] border-t border-purple-900/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight font-display mb-3">
          OUTRAS INFORMAÇÕES
        </h2>
        <p class="text-sm text-slate-400">
          Perguntas frequentes sobre a plataforma, planos, telas e suporte.
        </p>
      </div>

      <div class="space-y-4">
        {siteConfig.faqs.map((item) => (
          <details class="group rounded-2xl bg-[#120329] border border-purple-900/40 p-6 [&_summary::-webkit-details-marker]:hidden transition cursor-pointer">
            <summary class="flex items-center justify-between font-bold text-base text-white group-open:text-[#00f0ff]">
              <span>{item.q}</span>
              <span class="ml-4 flex-shrink-0 text-purple-400 transition group-open:rotate-180">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <p class="mt-4 text-sm text-slate-300 leading-relaxed border-t border-purple-900/40 pt-4">
              {item.a}
            </p>
          </details>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href={testWaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#00f0ff] hover:underline"
        >
          <span>FALAR COM NOSSA CENTRAL DE AJUDA NO WHATSAPP</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

    </div>
  </section>

</Layout>

<script>
  // Simple Hero Carousel Slider
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.slide-indicator');
  let current = 0;

  function showSlide(index: number) {
    slides.forEach((s, i) => {
      if (i === index) {
        s.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
        s.classList.add('opacity-100', 'z-10');
      } else {
        s.classList.remove('opacity-100', 'z-10');
        s.classList.add('opacity-0', 'pointer-events-none', 'z-0');
      }
    });
    dots.forEach((d, i) => {
      if (i === index) {
        d.classList.remove('bg-white/30', 'w-2.5');
        d.classList.add('bg-[#ff007a]', 'w-8');
      } else {
        d.classList.remove('bg-[#ff007a]', 'w-8');
        d.classList.add('bg-white/30', 'w-2.5');
      }
    });
    current = index;
  }

  dots.forEach((dot, idx) => {
    dot.addEventListener('click', () => showSlide(idx));
  });

  // Auto slide every 6 seconds
  setInterval(() => {
    const next = (current + 1) % slides.length;
    showSlide(next);
  }, 6000);
</script>
